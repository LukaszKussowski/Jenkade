<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jenkade.Presentation"
        x:Class="Jenkade.App.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="About Jenkade"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="32,24" Spacing="8" MinWidth="280">
    <TextBlock Text="Jenkade" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="A fast desktop front-end to Jenkins." />
    <StackPanel Orientation="Horizontal" Spacing="6">
      <TextBlock Text="Version" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock Name="Version" Text="{Binding Version}" />
    </StackPanel>
    <Button Content="OK" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0"
            Click="Close_Click" />
  </StackPanel>
</Window>
