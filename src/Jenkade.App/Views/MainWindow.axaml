<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jenkade.Presentation"
        xmlns:core="using:Jenkade.Core"
        x:Class="Jenkade.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Jenkade"
        Width="1000" Height="700">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Name="ConnectionMenuItem" Header="{x:Static vm:Strings.MenuConnection}">
        <MenuItem Name="ConnectionSettingsMenuItem" Header="{x:Static vm:Strings.MenuConnectionSettings}" Command="{Binding ShowConnectionSettingsCommand}" />
      </MenuItem>
      <MenuItem Name="HelpMenuItem" Header="{x:Static vm:Strings.MenuHelp}">
        <MenuItem Name="AboutMenuItem" Header="{x:Static vm:Strings.MenuAbout}" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Left" Width="280" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Panel Margin="16">
        <TextBlock Name="NoConnection" Text="{Binding NoConnectionMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   IsVisible="{Binding NoConnectionMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Spacing="2" IsVisible="{Binding Connection, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Name="ConnectionName" Text="{Binding ConnectionName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock DataContext="{Binding Connection}" x:DataType="core:Connection" Text="{Binding UserName}" FontSize="12"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
      </Panel>
    </Border>
    <Panel />
  </DockPanel>
</Window>
