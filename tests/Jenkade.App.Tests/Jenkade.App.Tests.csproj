<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless Avalonia in the Linux container: docs/headless-testing.md maps each piece to the failure it fixes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Jenkade.App\Jenkade.App.csproj" />
  </ItemGroup>
  <!-- The version MinVer computes at build time, to compare with what the About window shows. -->
  <Target Name="EmbedMinVerVersion" AfterTargets="MinVer">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>MinVerVersion</_Parameter1>
        <_Parameter2>$(MinVerVersion)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
